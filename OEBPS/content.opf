    <dc:title>Curls &amp; Contemplation: A Stylist’s Interactive Journey Journal</dc:title>
    <dc:language>en-US</dc:language>
    <dc:identifier id="bookid">urn:uuid:9fa5e2ef-5fd8-4f5b-9077-0b9e856cda3d</dc:identifier>
    <dc:creator id="creator01">MD Warren</dc:creator>
    <dc:publisher>MD Warren</dc:publisher>
    <dc:date>2025-05-27</dc:date>
    <dc:subject>Nonfiction</dc:subject>
    <dc:subject>Beauty</dc:subject>
    <dc:subject>Business</dc:subject>
    <dc:subject>Personal Development</dc:subject>
    <dc:subject>Hairstyling</dc:subject>
    <dc:subject>Entrepreneurship</dc:subject>
    <dc:subject>Professional Growth</dc:subject>
    <dc:subject>Self-Help</dc:subject>
    <dc:description>An interactive journey of creative mastery, business growth, and self-reflection for stylists, blending artistry, entrepreneurship and personal development. This comprehensive guide combines biblical wisdom with practical business acumen, featuring worksheets, self-assessments and professional development tools.</dc:description>
