  <!-- METADATA -->
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:title>The Artisan's Path: A Comprehensive Guide to Professional Hairstyling Excellence</dc:title>
    <dc:creator id="creator">Michael David Warren Jr.</dc:creator>
    <dc:language>en</dc:language>
    <dc:identifier id="book-id">urn:uuid:0d5f754f-20c8-4b21-a43b-acc861e034ed</dc:identifier>
    <dc:publisher>Terragon Labs</dc:publisher>
    <dc:date>2025-11-03</dc:date>
    <dc:rights>Copyright © 2025 Michael David Warren Jr. All rights reserved.</dc:rights>
    <dc:description>A transformative guide for professional hairstylists combining technical excellence, business acumen, and personal development. Featuring 16 comprehensive chapters, chapter-specific quizzes and worksheets, and practical guidance for building a thriving freelance hairstyling career.</dc:description>
    <dc:subject>Hairstyling</dc:subject>
    <dc:subject>Beauty Industry</dc:subject>
    <dc:subject>Professional Development</dc:subject>
    <dc:subject>Freelance Business</dc:subject>
    <dc:subject>Career Development</dc:subject>
    <meta property="dcterms:modified">2025-11-03T00:00:00Z</meta>
  </metadata>

